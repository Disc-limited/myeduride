{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/cleanup-old-media",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily-gate-digest",
      "schedule": "0 9,17 * * *"
    },
    {
      "path": "/api/cron/evening-escrow-settlement",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/pre-flight-balance-audit",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
